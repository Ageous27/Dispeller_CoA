<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Button name="DispellerCoAMUFTemplate" inherits="SecureActionButtonTemplate" virtual="true" hidden="true">
        <Size x="20" y="20"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBg" setAllPoints="true">
                    <Color r="0.08" g="0.35" b="0.12" a="0.70"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture name="$parentCD" hidden="true">
                    <Size x="8" y="8"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.55"/>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture alphaMode="ADD">
            <Color r="1" g="1" b="1" a="0.18"/>
        </HighlightTexture>
    </Button>

    <Frame name="DispellerCoA_MUFContainer" parent="UIParent" movable="true" enableMouse="false" clampedToScreen="true" hidden="true" frameStrata="MEDIUM">
        <Size x="24" y="36"/>
        <Anchors>
            <Anchor point="CENTER" x="180" y="80"/>
        </Anchors>
        <Frames>
            <Button name="DispellerCoA_MUFHandle" enableMouse="true">
                <Size x="20" y="10"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentBg" setAllPoints="true">
                            <Color r="0.06" g="0.06" b="0.06" a="0.95"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnEnter>
                        GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                        GameTooltip:SetText(DispellerCoA.L.HANDLE_TIP, nil, nil, nil, nil, 1)
                    </OnEnter>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
            </Button>
        </Frames>
    </Frame>
</Ui>
